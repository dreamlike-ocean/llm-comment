<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.dreamlike</groupId>
    <artifactId>llm-comment-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>comment-desktop</artifactId>
  <properties>
    <javafx.version>21.0.8</javafx.version>
    <app.mainClass>io.github.dreamlike.llmcomment.desktop.Main</app.mainClass>
    <app.imageName>llm-comment-desktop</app.imageName>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.github.dreamlike</groupId>
      <artifactId>comment-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>${project.build.directory}/generated-resources/desktop-fonts</directory></resource>
      <resource><directory>${project.build.directory}/generated-resources/desktop-javafx</directory></resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution><id>desktop-javafx-compat</id><phase>generate-sources</phase><goals><goal>exec</goal></goals>
            <configuration><executable>python3</executable><arguments>
              <argument>${project.basedir}/../scripts/prepare_desktop_javafx.py</argument>
              <argument>--source-output</argument><argument>${project.build.directory}/generated-sources/desktop-javafx</argument>
              <argument>--resource-output</argument><argument>${project.build.directory}/generated-resources/desktop-javafx</argument>
            </arguments></configuration>
          </execution>
          <execution><id>desktop-font-resources</id><phase>generate-resources</phase><goals><goal>exec</goal></goals>
            <configuration><executable>python3</executable><arguments>
              <argument>${project.basedir}/../scripts/prepare_desktop_fonts.py</argument>
              <argument>--output</argument><argument>${project.build.directory}/generated-resources/desktop-fonts</argument>
            </arguments></configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId><version>3.6.1</version>
        <executions><execution><id>desktop-javafx-source</id><phase>generate-sources</phase><goals><goal>add-source</goal></goals>
          <configuration><sources><source>${project.build.directory}/generated-sources/desktop-javafx</source></sources></configuration>
        </execution></executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters><filter><artifact>*:*</artifact><excludes>
                <exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude>
                <exclude>module-info.class</exclude><exclude>META-INF/versions/*/module-info.class</exclude>
              </excludes></filter>
                <filter><artifact>org.openjfx:javafx-graphics</artifact><excludes>
                  <exclude>com/sun/javafx/font/freetype/PangoGlyphLayout.class</exclude>
                </excludes></filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${app.mainClass}</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>native-test</id>
      <build><plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><version>3.9.0</version>
          <executions><execution><id>desktop-native-classpath</id><phase>prepare-package</phase><goals><goal>build-classpath</goal></goals>
            <configuration><includeScope>runtime</includeScope><outputFile>${project.build.directory}/native-classpath.txt</outputFile></configuration>
          </execution></executions>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
          <executions>
            <execution><id>desktop-native-build</id><phase>package</phase><goals><goal>exec</goal></goals>
              <configuration><executable>python3</executable><arguments>
                <argument>${project.basedir}/../scripts/build_desktop_native.py</argument>
                <argument>--module</argument><argument>${project.basedir}</argument>
                <argument>--java-home</argument><argument>${java.home}</argument>
                <argument>--optimization=${native.optimization}</argument>
              </arguments></configuration>
            </execution>
            <execution><id>desktop-native-smoke</id><phase>verify</phase><goals><goal>exec</goal></goals>
              <configuration><executable>${project.build.directory}/llm-comment-desktop</executable>
                <arguments><argument>--smoke-test</argument></arguments><timeout>60000</timeout>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins></build>
    </profile>
    <profile>
      <id>native-release</id>
      <build><plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><version>3.9.0</version>
          <executions><execution><id>desktop-native-classpath</id><phase>prepare-package</phase><goals><goal>build-classpath</goal></goals>
            <configuration><includeScope>runtime</includeScope><outputFile>${project.build.directory}/native-classpath.txt</outputFile></configuration>
          </execution></executions>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
          <executions>
            <execution><id>desktop-native-build</id><phase>package</phase><goals><goal>exec</goal></goals>
              <configuration><executable>python3</executable><arguments>
                <argument>${project.basedir}/../scripts/build_desktop_native.py</argument>
                <argument>--module</argument><argument>${project.basedir}</argument>
                <argument>--java-home</argument><argument>${java.home}</argument>
                <argument>--optimization=${native.optimization}</argument>
              </arguments></configuration>
            </execution>
            <execution><id>desktop-native-smoke</id><phase>verify</phase><goals><goal>exec</goal></goals>
              <configuration><executable>${project.build.directory}/llm-comment-desktop</executable>
                <arguments><argument>--smoke-test</argument></arguments><timeout>60000</timeout>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins></build>
    </profile>
  </profiles>
</project>
